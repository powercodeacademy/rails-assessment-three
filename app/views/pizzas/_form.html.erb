<%= form_with model: @pizza, local: true do |form| %>
  <% if @pizza.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@pizza.errors.count, "error") %> prohibited this pizza from being saved:</h2>

      <ul>
      <% @pizza.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :pizzeria_id, "Pizzeria" %>
    <%= form.collection_select :pizzeria_id, Pizzeria.all, :id, :name, prompt: "Select a pizzeria" %>
  </div>

  <%= form.submit %>
<% end %>
