<!DOCTYPE html>
<html>
  <head>
    <title>ImmersiveRailsAlternateAssessmentRoundTwo</title>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class='container'>
      <p align="center"><%= image_tag "prisoners_pizza.png", class: "pizza_logo"%></p>
      <h1 align='center' style='font-size:3rem;color:#d12b15'>The NYC Pizza Society</h1>
      <%= yield %>
    </div>
  </body>

  <footer class="footer">
  <h4>Quick Navigation Links</h4>
  <div>
    <%= link_to 'Add New Pizza', new_pizza_path %>
    <%= link_to 'View All Pizzerias', pizzerias_path %>
    <%= link_to 'View All Pizzas', pizzas_path %>
  </div>
</footer>
</html>
