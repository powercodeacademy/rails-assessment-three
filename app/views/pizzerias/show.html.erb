<h1 style='margin-top:100px'>Pizzeria name: <%= @pizzeria.name %></h1>
<p>Address: <%= @pizzeria.address %></p>
<ul>
  <% @pizzeria.pizzas.each do |pizza| %>
    <li><%= link_to pizza.name, pizzeria_pizza_path(@pizzeria, pizza) %></li>
  <% end %>
</ul>
<%= link_to "Add a Pizza", new_pizzeria_pizza_path(@pizzeria) %>
