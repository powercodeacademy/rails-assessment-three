<h1 style='margin-top:100px'>Pizzeria name: <%= @pizzeria.name %></h1>
<p>Address: <%= @pizzeria.address %></p>
<p><%= link_to "Tell us about a great Pizza you had at #{@pizzeria.name}", new_pizzeria_pizza_path(pizzeria_id: @pizzeria.id) %></p>
<br>
<h2>Great eats from <%= @pizzeria.name %>:</h2>
<% @pizzeria.pizzas.each do |pizza| %>
  <%= link_to pizza.name, pizzeria_pizza_path(pizzeria_id: @pizzeria.id, pizza: pizza) %>
<% end %>
